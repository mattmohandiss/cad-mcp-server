{
  "name": "cad-mcp-server",
  "version": "0.7.1",
  "mcpName": "io.github.mattmohandiss/cad-mcp-server",
  "description": "Give your AI assistant the ability to inspect, measure, and compare 3D CAD models. Works locally with any STEP file — no CAD license, no cloud, no setup.",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/eval",
    "!dist/src/tests",
    "!dist/vitest.config.*",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/EXAMPLE_PROMPTS.md",
    "server.json"
  ],
  "bin": {
    "cad-mcp-server": "dist/src/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "preferUnplugged": true,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write src/",
    "lint": "oxlint src/ eval/",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,eval}/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.sh": [
      "bash -n"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cad",
    "step",
    "stp",
    "3d",
    "mechanical-engineering",
    "manufacturing",
    "dfm",
    "gdandt",
    "pmi",
    "geometry",
    "inspection",
    "quality",
    "b-rep",
    "opencascade",
    "occt",
    "sidecar",
    "claude",
    "ai-tools"
  ],
  "author": "Matt Mohandiss <mattmohandiss@gmail.com>",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mattmohandiss"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/mattmohandiss/cad-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattmohandiss/cad-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/mattmohandiss/cad-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@ai-sdk/mcp": "^2.0.66",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.4",
    "ai": "^7.0.127",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.1",
    "vitest": "^5.0.3"
  }
}
