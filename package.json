{
  "name": "cad-mcp-server",
  "version": "0.9.0",
  "mcpName": "io.github.ottonic/cad-mcp-server",
  "description": "Measure STEP CAD files with your AI assistant: dimensions, wall thickness, clearance, draft, and revision diffs. Local, read-only, no CAD license.",
  "type": "module",
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "dist/package.json",
    "!dist/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES",
    "docs/EXAMPLE_PROMPTS.md",
    "docs/images",
    "server.json"
  ],
  "bin": {
    "cad-mcp-server": "dist/src/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "fmt": "prettier --write src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts",
    "fmt:check": "prettier --check src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.sh": [
      "bash -n"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cad",
    "step",
    "stp",
    "3d",
    "mechanical-engineering",
    "manufacturing",
    "dfm",
    "gdandt",
    "pmi",
    "geometry",
    "inspection",
    "quality",
    "wall-thickness",
    "clearance",
    "draft-angle",
    "revision-compare",
    "b-rep",
    "opencascade",
    "occt",
    "sidecar",
    "claude",
    "ai-tools"
  ],
  "author": "Matt Mohandiss <mattmohandiss@gmail.com>",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mattmohandiss"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/ottonic/cad-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ottonic/cad-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ottonic/cad-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.116",
    "@ai-sdk/mcp": "^2.0.78",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "ai": "^7.0.143",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "vitest": "^5.0.5"
  }
}
