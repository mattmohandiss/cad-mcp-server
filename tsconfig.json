{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": ["ESNext"],
    "types": ["node"],
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "occt"]
}
