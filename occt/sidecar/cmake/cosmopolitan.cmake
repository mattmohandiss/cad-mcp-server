set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES COSMO_ROOT)
if(NOT DEFINED COSMO_ROOT)
  message(FATAL_ERROR "Set COSMO_ROOT to extracted cosmocc toolchain")
endif()
set(CMAKE_C_COMPILER "${COSMO_ROOT}/bin/cosmocc")
set(CMAKE_CXX_COMPILER "${COSMO_ROOT}/bin/cosmoc++")
set(COSMO_AR "${COSMO_ROOT}/bin/cosmoar")
configure_file("${CMAKE_CURRENT_LIST_DIR}/cosmoar.py.in" "${CMAKE_BINARY_DIR}/cosmoar-wrapper" @ONLY)
file(CHMOD "${CMAKE_BINARY_DIR}/cosmoar-wrapper" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(CMAKE_AR "${CMAKE_BINARY_DIR}/cosmoar-wrapper" CACHE FILEPATH "Response-file compatible cosmoar" FORCE)
set(CMAKE_RANLIB "${COSMO_ROOT}/bin/cosmoar")
set(CMAKE_C_ARCHIVE_FINISH "")
set(CMAKE_CXX_ARCHIVE_FINISH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-mcosmo")
set(CMAKE_CXX_FLAGS_INIT "-mcosmo")
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
