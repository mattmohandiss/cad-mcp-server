# Copy to .env and uncomment what you need. Every value is optional.

# Native OCCT sidecar binary and optional APE launcher (see docs/DEVELOPMENT.md).
# CAD_MCP_SIDECAR=/path/to/occt-sidecar
# CAD_MCP_SIDECAR_LAUNCHER=/path/to/launcher

# Server logging (stderr only): level debug|info|warn|error, format json|human.
MCP_LOG_LEVEL=info
MCP_LOG_FORMAT=json
# Optional correlation id included in every log record.
MCP_TRACE_ID=
